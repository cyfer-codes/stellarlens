API_URL=http://localhost:3000
API_KEY=
# Optional read-scoped api key (create one with scope "read"). When set, every
# GET this app proxies to the api — including all PUBLIC_DEMO traffic, which
# the middleware only ever lets through for GETs — uses this key instead of
# the full-scope API_KEY, so a bug in the read-only allow-list can't become a
# write. Falls back to API_KEY when unset.
API_READ_KEY=
DATABASE_URL=postgres://stellarlens:stellarlens@localhost:5433/stellarlens
SESSION_SECRET=
SEED_ADMIN_EMAIL=admin@stellarlens.local
SEED_ADMIN_PASSWORD=

# When true, /contracts, /events, /transfers and their read-only api routes are
# browsable without a session (write actions still require login). Populate
# with realistic-looking data via `pnpm seed-demo` first.
PUBLIC_DEMO=false
