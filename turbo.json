{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL", "SOROBAN_RPC_URL", "STELLAR_NETWORK"]
    },
    "@stellarlens/indexer#test": {
      "dependsOn": ["^build", "@stellarlens/api#test"],
      "env": ["DATABASE_URL", "SOROBAN_RPC_URL", "STELLAR_NETWORK"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
