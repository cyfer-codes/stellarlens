DATABASE_URL=postgres://stellarlens:stellarlens@localhost:5433/stellarlens
REDIS_URL=redis://localhost:6379
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK=testnet

# Local development only: allow plain http:// webhook urls (e.g. http://localhost:4000/hook).
# Leave unset in production — webhook urls must use https:// otherwise.
# ALLOW_INSECURE_WEBHOOK_URLS=true
# Maximum concurrent webhook deliveries per indexed event
WEBHOOK_CONCURRENCY=10
# Webhook delivery tuning (defaults shown). Retries after the first attempt (0 disables retries),
# exponential backoff base/cap, and the per-attempt request timeout.
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_BASE_DELAY_MS=500
WEBHOOK_RETRY_MAX_DELAY_MS=5000
WEBHOOK_TIMEOUT_MS=5000
# Shared secret required by the indexer registry server's POST /contracts endpoint.
# Clients must send it in the X-Registry-Secret header.
REGISTRY_SECRET=replace-with-a-long-random-registry-secret
# Set to true for one poll cycle; the indexer skips the registry server and exits
POLL_ONCE=false
SITE_URL=http://localhost:3000
POLL_INTERVAL_MS=5000

# Comma-separated allow-list of origins permitted to make cross-origin requests
# (e.g. "https://app.example.com,https://admin.example.com"). Leave unset to
# disable cross-origin access entirely.
CORS_ORIGINS=
