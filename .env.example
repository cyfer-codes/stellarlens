DATABASE_URL=postgres://stellarlens:stellarlens@localhost:5433/stellarlens
REDIS_URL=redis://localhost:6379
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK=testnet
# Maximum concurrent webhook deliveries per indexed event
WEBHOOK_CONCURRENCY=10
# Set to true for one poll cycle; the indexer skips the registry server and exits
POLL_ONCE=false
SITE_URL=http://localhost:3000
POLL_INTERVAL_MS=5000

# Comma-separated allow-list of origins permitted to make cross-origin requests
# (e.g. "https://app.example.com,https://admin.example.com"). Leave unset to
# disable cross-origin access entirely.
CORS_ORIGINS=
